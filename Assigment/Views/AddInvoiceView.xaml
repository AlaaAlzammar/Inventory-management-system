<Window x:Class="Assigment.Views.AddInvoiceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assigment.Views"
        mc:Ignorable="d"
        Title="AddInvoiceView" Height="450" Width="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 1: Supplier -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Customer" Width="80" VerticalAlignment="Center"/>
            <ComboBox  ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                       Text="{Binding selectedCustomer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       DisplayMemberPath="CustomerName"
                       IsEditable="True"
                       StaysOpenOnEdit="True"
                       IsTextSearchCaseSensitive="True"
                       x:Name="cmbSupplier" Width="220"/>
            <TextBlock Text="Phone" Margin="30 5"
             />
            <TextBox Text="{Binding PhoneNumber}"
           Margin="5"
           Width="100"/>
            <TextBlock Text="Address" Margin="30 5"
  />
            <TextBox Text="{Binding Address}"
Margin="5"
Width="100"/>


        </StackPanel>

        <!-- Row 2: Item, Quantity, Price -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Item" Width="50" VerticalAlignment="Center"/>
            <ComboBox x:Name="cmbItem" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True"
StaysOpenOnEdit="True"
IsTextSearchCaseSensitive="True"
                       
                      Width="150" Margin="0,0,15,0"/>



            <TextBlock Text="Quantity" Width="60" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding MeausringUnitText}" Width="60" VerticalAlignment="Center"/>

            <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             GotFocus="TextBox_GotFocus"
                             LostFocus="TextBox_LostFocus"
                             x:Name="txtQuantity" Width="70" Margin="0,0,15,0"/>

            <TextBlock Text="Price" Width="40" VerticalAlignment="Center"/>
            <TextBox Text="{Binding SalePrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:Name="txtPurchasePrice"
                      GotFocus="TextBox_GotFocus"
                     LostFocus="TextBox_LostFocus"
                     Width="80" Margin="0,0,15,0"/>
           

            <Button  Command="{Binding AddInvoiceItemCommand}" x:Name="btnAdd" Content="Add" Width="60" />
        </StackPanel>

        <!-- Row 3: DataGrid -->
        <DataGrid 
                    ItemsSource="{Binding InvoiceItems}"
                    x:Name="dgItems"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item" Binding="{Binding Item.Name}" Width="2*"/>
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="*"/>
                <DataGridTextColumn Header="Purchase Price" Binding="{Binding SalePrice, StringFormat=N2}" Width="*"/>
                <DataGridTextColumn Header="Line Total" Binding="{Binding TotalAmount, StringFormat=N2}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row 4: Total and Save -->
        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right">
            <TextBlock Text="Extra Cahrges:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
            <TextBlock Text="{Binding ExtraCharges}" x:Name="txtTotal"  VerticalAlignment="Center" Width="80" Margin="0,0,15,0"/>

            <TextBlock Text="Discount:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
            <TextBlock Text="{Binding Discount}"   VerticalAlignment="Center" Width="80" Margin="0,0,15,0"/>

            <TextBlock Text="Piad Amount:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
            <TextBlock Text="{Binding PaidAmount}"   VerticalAlignment="Center" Width="80" Margin="0,0,15,0"/>

            <TextBlock Text="Total Amount:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
            <TextBlock Text="{Binding InvoiceTotal}"  VerticalAlignment="Center" Width="80" Margin="0,0,15,0"/>
            <Button  Command="{Binding SaveCommand}" x:Name="btnSave" Content="Save" Width="80"/>
        </StackPanel>



    </Grid>
</Window>
