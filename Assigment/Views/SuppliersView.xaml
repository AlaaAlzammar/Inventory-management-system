<Window x:Class="Assigment.Views.SuppliersView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assigment.Views"
        mc:Ignorable="d"
        Title="SuppliersView" Height="450" Width="800">
    <Grid>
        <!-- Two Columns -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN : Items List -->
        <Border Grid.Column="0"
           BorderBrush="Gray"
           BorderThickness="1"
           Margin="5"
           Padding="10">

            <StackPanel>

                <TextBlock Text="Available Items"
                      FontSize="20"
                      FontWeight="Bold"
                      Margin="0,0,0,10"/>

                <ListView ItemsSource="{Binding Suppliers}"
                    SelectedItem="{Binding SelectedSupplier}"
                    Height="400">

                    <ListView.View>
                        <GridView>


                            <GridViewColumn DisplayMemberBinding="{Binding Name}"
                                         Width="120"
                                          Header="Name"/>
                            <GridViewColumn DisplayMemberBinding="{Binding Address}"
            Width="120"
            Header="Phone " />

                            <GridViewColumn DisplayMemberBinding="{Binding Phone}"
                                        Width="120"
                                        Header="Phone " />

                 
                        

                        </GridView>
                    </ListView.View>

                </ListView>

            </StackPanel>

        </Border>

        <!-- RIGHT COLUMN : Add / Update Item -->
        <Border Grid.Column="1"
           BorderBrush="Gray"
           BorderThickness="1"
           Margin="5"
           Padding="15">

            <StackPanel>

                <TextBlock Text="Add / Update Item"
                      FontSize="22"
                      FontWeight="Bold"
                      Margin="0,0,0,20"/>

                <!-- Name -->
                <TextBlock Text="Name"/>
                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    Margin="0,5,0,10"
    Height="30"/>
                <TextBlock Text="Address"/>
                <TextBox Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,5,0,10"
                    Height="30"/>

                <!-- Details -->
                <TextBlock Text="phone"/>
                <TextBox Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,5,0,10"
                    Height="60"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"/>

             
                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                       HorizontalAlignment="Center">

                    <Button Content="Save"
                       Command="{Binding SaveCommand}"
                       Width="100"
                       Height="35"
                       Margin="5"/>

                    <Button Content="Update"
                       Command="{Binding UpdateCommand}"
                       Width="100"
                       Height="35"
                       Margin="5"/>

                </StackPanel>

            </StackPanel>

        </Border>
    </Grid>
</Window>
