<Window x:Class="Assigment.Views.ItemsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assigment.Views"
        mc:Ignorable="d"
        Title="ItemsView" Height="520" Width="800">
    <Grid Margin="10">

        <!-- Two Columns -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN : Items List -->
        <Border Grid.Column="0"
                BorderBrush="Gray"
                BorderThickness="1"
                Margin="5"
                Padding="10">

            <StackPanel>

                <TextBlock Text="Available Items"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <ListView ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         Height="400">

                    <ListView.ItemTemplate>
                        <DataTemplate>

                            <Border BorderBrush="LightGray"
                                    BorderThickness="1"
                                    Margin="2"
                                    Padding="5">

                                <StackPanel>

                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="Bold"
                                               FontSize="16"/>

                                    <TextBlock Text="{Binding Details}"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Price,
                                               StringFormat=Price: {0:C}}"/>
                                    <TextBlock Text="{Binding StockValue,
            StringFormat=Price: {0:C}}"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

            </StackPanel>

        </Border>

        <!-- RIGHT COLUMN : Add / Update Item -->
        <Border Grid.Column="1"
                BorderBrush="Gray"
                BorderThickness="1"
                Margin="5"
                Padding="15">

            <StackPanel>

                <TextBlock Text="Add / Update Item"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <!-- Name -->
                <TextBlock Text="Name"/>
                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,10"
                         Height="30"/>

                <!-- Details -->
                <TextBlock Text="Details"/>
                <TextBox Text="{Binding Details, Mode=TwoWay}"
                         Margin="0,5,0,10"
                         Height="60"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"/>

                <!-- Price -->
                <TextBlock Text="Price"/>
                <TextBox Text="{Binding Price, Mode=TwoWay}"
                         Margin="0,5,0,10"
                         Height="30"/>

                <!-- Measuring Unit -->
                <TextBlock Text="Measuring Unit"/>
                <TextBox Text="{Binding measuringUnit, Mode=TwoWay}"
                         Margin="0,5,0,10"
                         Height="30"/>

                <!-- ReOrder Level -->
                <TextBlock Text="ReOrder Level"/>
                <TextBox Text="{Binding ReOrderLevel, Mode=TwoWay}"
                         Margin="0,5,0,20"
                         Height="30"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Width="100"
                            Height="35"
                            Margin="5"/>

                    <Button Content="Update"
                            Command="{Binding UpdateCommand}"
                            Width="100"
                            Height="35"
                            Margin="5"/>

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>

</Window>
